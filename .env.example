# Cadena de conexión a MongoDB (local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/predictimpacto
# Puerto de la API Express
PORT=4000
# Secreto para firmar los JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-este-secreto
# Vigencia del token
JWT_EXPIRES_IN=8h
# Usuario sembrado por scripts/seed.js (no hay registro)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=cambia-esta-clave
